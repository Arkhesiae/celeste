{{> hello }}
<mj-section><mj-column>
  <mj-text mj-class="title">Rappel : {{effectiveTypeText}} demain</mj-text>
  <mj-text>Demain, vous êtes engagé(e) pour {{effectiveTypeLower}} avec <strong>{{posterName}}</strong> :</mj-text>
</mj-column></mj-section>
{{> demand }}
<mj-section><mj-column>
  {{#if exchangedShift}}
  <mj-text padding="14px 0 0">En échange, <strong>{{posterName}}</strong> effectue votre vacation habituelle ({{exchangedShift}}).</mj-text>
  {{/if}}
  <mj-text mj-class="muted" padding="10px 0 0">Un empêchement ? Retirez-vous de la demande depuis l'application dès que possible afin que {{posterName}} puisse trouver quelqu'un d'autre.</mj-text>
</mj-column></mj-section>
{{> contact person=posterContact label="Pour joindre l'auteur de la demande" }}
{{> button }}
