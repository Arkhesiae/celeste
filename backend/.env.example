# Configuration du backend : copier ce fichier en `backend/.env` (le seul fichier lu : `import 'dotenv/config'` en tête de
# server.js) et remplir les valeurs. `.env` n'est pas suivi par git ; ce fichier-ci l'est, il ne doit contenir aucun secret.
#
# [obligatoire] = le serveur ne démarre pas ou ne fonctionne pas sans la valeur
# [production]  = à définir en production ; une valeur par défaut existe mais n'est pas sûre ou pas adaptée
# [facultatif]  = la valeur par défaut indiquée s'applique si la variable est absente

# ─── Serveur ──────────────────────────────────────────────────────────────────

# development | production. En production : cookies « secure », mails envoyés par SES (sinon affichés dans la console),
# code OTP envoyé par mail (sinon affiché dans la console).
NODE_ENV=development

# [facultatif] port d'écoute (défaut : 3000)
PORT=3000

# [obligatoire] connexion MongoDB. Un replica set est nécessaire (transactions) : `docker compose -f docker-compose.dev.yml up -d`
# démarre un MongoDB local « rs0 ». En production : voir le docker-compose.yml à la racine (.env.prod).
MONGO_URI=mongodb://localhost:27017/celeste?replicaSet=rs0

# Adresse du front, autorisée par CORS (origine du navigateur, sans « / » final)
FRONT_URL=http://localhost:5173

# Adresse du front utilisée dans les liens des mails (réinitialisation du mot de passe). [facultatif] défaut : http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── Authentification ─────────────────────────────────────────────────────────

# [production] secrets de signature des jetons. Sans eux le code retombe sur 'secret' et 'refresh-secret', qui sont publics
# (known issue #4) : générer deux longues valeurs aléatoires différentes.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# [facultatif] durée de vie du jeton d'accès (défaut : 15m)
ACCESS_TOKEN_EXPIRY=15m

# Compte administrateur principal, créé ou mis à jour à chaque démarrage (bootstrap/seedAdmin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Base des mots de passe des administrateurs locaux (un compte admin-<oaci>@celeste-app.fr par centre, mot de passe
# « <base>-<oaci> »). Sans cette variable aucun administrateur local n'est créé ni modifié.
LOCAL_ADMIN_PASSWORD=change-me

# ─── Mails ────────────────────────────────────────────────────────────────────

# Hors production les mails sont affichés dans la console. MAIL_SERVICE est lu par le code mais n'a aucun effet : c'est
# NODE_ENV qui décide (services/email/email.transport.js).
MAIL_SERVICE=console

# [production] Amazon SES (SMTP)
SES_HOST=
EMAIL_PORT=587
SES_USERNAME=
SES_PASSWORD=

# [facultatif] expéditeur des mails d'approbation (défaut : « Celeste <noreply@celeste-app.fr> »)
EMAIL_FROM=Celeste <noreply@example.com>

# Adresse de l'administrateur principal, destinataire des tickets du formulaire de contact
MASTER_ADMIN_EMAIL=admin@example.com

# ─── Comportement ─────────────────────────────────────────────────────────────

# [facultatif] heure locale (du centre) d'envoi du rappel de la veille aux remplaçants (défaut : 18)
REMINDER_HOUR=18

# [facultatif] explore les variantes d'horaires ambiguës dans les listes de demandes (défaut : false)
EXPLORE_VARIATIONS=false

# [facultatif] géocodeur de la carte des centres (défauts : Nominatim d'OpenStreetMap, agent « Celeste-app/1.0 »)
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=Celeste-app/1.0

# ─── Tests et scripts ─────────────────────────────────────────────────────────

# [facultatif] base jetable des tests (`npm test`), supprimée avant et après (défaut : mongodb://127.0.0.1:27017/celeste_test_compat)
TEST_MONGO_URI=mongodb://127.0.0.1:27017/celeste_test_compat
